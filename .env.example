# Copia a .env y ajusta. NUNCA subas .env al repositorio.

# Conexión de MIGRACIONES (rol propietario del esquema).
DATABASE_URL_OWNER=postgres://rrhh_owner:dev_owner_pwd@localhost:5433/rrhh

# Conexión de la APLICACIÓN en runtime (rol NOBYPASSRLS, sujeto a RLS).
DATABASE_URL_APP=postgres://rrhh_app:dev_app_pwd@localhost:5433/rrhh

# Servidor
PORT=3001
NODE_ENV=development

# Sesiones
SESSION_TTL_HORAS=8
SESSION_INACTIVIDAD_MINUTOS=30
MAX_INTENTOS_LOGIN=5
BLOQUEO_MINUTOS=15

# Clave de cifrado en reposo (secretos TOTP, documento). En prod: gestor de secretos.
# 32 bytes en base64. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=cambia_esto_por_una_clave_de_32_bytes_en_base64=
