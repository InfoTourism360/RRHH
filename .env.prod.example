# Plantilla de secretos del despliegue de producción.
# Copia a .env.prod (o genéralo con scripts/preparar-produccion.sh) y NO lo subas.

# Contraseña del rol propietario de PostgreSQL (migraciones y provisioning).
DB_OWNER_PWD=cambia_esto

# Contraseña del rol de aplicación (NOBYPASSRLS). El runner de migraciones
# sincroniza el rol de la base de datos con este valor.
DB_APP_PWD=cambia_esto_tambien

# Clave de cifrado en reposo (32 bytes en base64): semillas TOTP y datos sensibles.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Puertos publicados por nginx.
PUERTO_HTTP=8080
PUERTO_HTTPS=8443

# nginx.conf (solo HTTP) o nginx-https.conf (redirección a TLS).
NGINX_CONF=nginx.conf

# Rótulo de "entorno de demostración" en la interfaz.
# Para una entidad real déjalo en false.
MODO_DEMO=false
